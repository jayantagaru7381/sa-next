{
  "name": "source-advisors-overhaul",
  "author": "source advisors",
  "version": "7.3.0",
  "description": "Overhaul Project for Source Advisors",
  "private": true,
  "scripts": {
    "dev": "node --require ./load-appinsights.js node_modules/next/dist/bin/next dev -p 8083 --turbopack",
    "start": "node --require ./load-appinsights.js node_modules/next/dist/bin/next start -p 8083",
    "build": "next build",
    "lint": "node scripts/lint-with-warnings.js \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "lint:strict": "cross-env STRICT_LINT=true node scripts/lint-with-warnings.js \"src/**/*.{ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "npm run clean && npm install && npm run dev",
    "re:build": "npm run clean && npm install && npm run build",
    "re:build-npm": "npm run clean && npm install && npm run build",
    "tsc:dev": "npm run dev & npm run tsc:watch",
    "tsc:watch": "tsc --noEmit --watch",
    "tsc:print": "npx tsc --showConfig",
    "test": "cross-env NODE_OPTIONS=--no-deprecation jest && node scripts/check-coverage-warnings.js",
    "test:watch": "NODE_OPTIONS=\"--no-deprecation\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--no-deprecation\" jest --coverage && node scripts/check-coverage-warnings.js",
    "test:ci": "NODE_OPTIONS=\"--no-deprecation\" jest --ci --coverage --watchAll=false && node scripts/check-coverage-warnings.js",
    "test:strict": "STRICT_COVERAGE=true NODE_OPTIONS=\"--no-deprecation\" jest --ci --coverage --watchAll=false",
    "test:dev": "SKIP_COVERAGE_THRESHOLD=true NODE_OPTIONS=\"--no-deprecation\" jest",
    "test:dev:watch": "SKIP_COVERAGE_THRESHOLD=true NODE_OPTIONS=\"--no-deprecation\" jest --watch",
    "test:dev:coverage": "SKIP_COVERAGE_THRESHOLD=true NODE_OPTIONS=\"--no-deprecation\" jest --coverage",
    "test:ci:dev": "SKIP_COVERAGE_THRESHOLD=true NODE_OPTIONS=\"--no-deprecation\" jest --ci --coverage --watchAll=false",
    "test:skip-failing": "SKIP_FAILING_TESTS=true NODE_OPTIONS=\"--no-deprecation\" jest",
    "test:skip-pattern": "NODE_OPTIONS=\"--no-deprecation\" jest",
    "test:only": "NODE_OPTIONS=\"--no-deprecation\" jest",
    "test:focus": "NODE_OPTIONS=\"--no-deprecation\" jest --findRelatedTests",
    "quality:collect": "node scripts/collect-quality-metrics.js",
    "quality:format": "node scripts/format-github-output.js",
    "quality:full": "npm run quality:collect && npm run quality:format summary",
    "quality:bundle": "node scripts/update-bundle-metrics.js",
    "quality:validate": "node scripts/validate-quality-setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/nunito-sans": "^5.2.6",
    "@fontsource-variable/public-sans": "^5.2.6",
    "@fontsource/barlow": "^5.2.6",
    "@hookform/resolvers": "^5.1.1",
    "@iconify/react": "^6.0.0",
    "@mui/lab": "^7.0.0-beta.14",
    "@mui/material": "^7.1.2",
    "@mui/material-nextjs": "^7.1.1",
    "@mui/stylis-plugin-rtl": "^7.1.0",
    "@mui/x-data-grid": "^8.5.3",
    "@mui/x-date-pickers": "^8.5.3",
    "@mui/x-tree-view": "^8.5.3",
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/postcss": "^4.1.11",
    "applicationinsights": "^3.8.0",
    "autoprefixer": "^10.4.21",
    "autosuggest-highlight": "^3.3.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.2",
    "es-toolkit": "^1.39.3",
    "framer-motion": "^12.18.1",
    "lottie-react": "^2.4.1",
    "minimal-shared": "^1.0.15",
    "next": "^15.3.4",
    "nprogress": "^0.2.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "simplebar-react": "^3.3.0",
    "stylis": "^4.3.6",
    "tailwindcss": "^4.1.11",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@jest/types": "^29.6.3",
    "@next/eslint-plugin-next": "^15.4.5",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/autosuggest-highlight": "^3.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/parser": "^8.34.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "optionalDependencies": {
    "lightningcss": "^1.30.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node scripts/lint-with-warnings.js",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
